<style>
.section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .section-{{ section.id }}-padding img{max-width:100%;}
  .section-{{ section.id }}-padding .section-header{padding:0 0 25px;}
  .section-{{ section.id }}-padding .section-header h2{margin:0; padding:0; font-weight: 400;font-family: "Lustria", serif;font-size: 36px;letter-spacing: 0px;}

 .section-{{ section.id }}-padding .hotspot-wrapper {
    display: flex;
    flex-flow: wrap;
    gap: 15px;
}
.section-{{ section.id }}-padding  .hotspot-wrapper-item{  position: relative; width: calc(33.33% - 15px* 2 / 3);}

.section-{{ section.id }}-padding .hotspot-featured-image img {  width: 100%;  display: block;}

.section-{{ section.id }}-padding .hotspot-point {
  position: absolute;
  transform: translate(-50%, -50%);
  background: #F8F8F8E5;
  color: #fff;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
  cursor: pointer;
}

/* Popup */
.section-{{ section.id }}-padding .hotspot-popup {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  justify-content: center;
  align-items: center;
  z-index: 3;
}

.section-{{ section.id }}-padding .open_popup{  display: flex;}

.section-{{ section.id }}-padding .hotspot-popup-max {
  background: #fff;
  padding: 30px 20px;
  max-width: 331px;
  width: 100%;
  position: relative; 
  box-shadow: 0px 2px 4px 0px #00000033;

}

.section-{{ section.id }}-padding .hotspot-popup-inner{display:flex; gap:10px;}
.section-{{ section.id }}-padding .hotspot-popup-left {width:120px;}
.section-{{ section.id }}-padding .hotspot-popup-right {width:calc(100% - 120px);}
.section-{{ section.id }}-padding .hotspot-popup-left img {    height: 140px;    object-fit: cover;     display: block;   width: 100%;}
.section-{{ section.id }}-padding .hotspot-popup-right .pro_title {    font-size: 16px;    letter-spacing: 0;    font-weight: 300; margin:0;     padding: 5px 0 14px;}
.section-{{ section.id }}-padding .hotspot-price{font-family: "Lustria", serif;   font-weight: 400;  font-style: normal; letter-spacing: 0; padding:0 0 8px;  }
.section-{{ section.id }}-padding .hotspot-description{font-weight: 300; font-size: 14px;letter-spacing: -0.14px; line-height:1.1; }
.section-{{ section.id }}-padding .hotspot-description p{margin:0; padding:0;}
.section-{{ section.id }}-padding .close-btn {  position: absolute;  top: 10px;  right: 15px;  cursor: pointer;  }

/* Button */
.section-{{ section.id }}-padding .btn-custom {
  position: relative;
  overflow: hidden;
  padding: 13px 32px;
  background: {{ section.settings.btn_color }};
  text-decoration: none;
  color: {{ section.settings.btn_text_color  }};
  font-weight: 400;
  display: inline-block;
  transition: color 0.3s ease;  width: 100%;
  text-transform: uppercase;
  border:0;
  font-family: var(--font-body-family);
  font-style: var(--font-body-style);
  font-weight: var(--font-body-weight);
  cursor: pointer;     font-size: 16px;
}

.section-{{ section.id }}-padding .btn-custom::before {
  content: "";
  position: absolute;
  left: -100%;
  top: 0;
  width: 100%;
  height: 100%;
  background: {{ section.settings.btn_hover_color }};
  transition: left 0.3s ease;
  z-index: 0;
}

.section-{{ section.id }}-padding .btn-custom:hover::before {  left: 0;}
.section-{{ section.id }}-padding .btn-custom span {  position: relative;  z-index: 1;  display: flex;    align-items: center;    gap: 10px;    justify-content: center;}
.section-{{ section.id }}-padding .btn-custom:hover {  color: {{ section.settings.btn_text_color_h }}; box-shadow: 0px 2px 4px 0px #00000033;}
.section-{{ section.id }}-padding .btn-custom path{fill: {{ section.settings.btn_text_color  }};}
.section-{{ section.id }}-padding .btn-custom:hover path{ fill: {{ section.settings.btn_text_color_h  }};}

 .section-{{ section.id }}-padding .hotspot-popup-bottom-space {    padding: 0 0 35px;}
 .section-{{ section.id }}-padding .variants-label {
    display: block;
    margin: 0 0 5px;
    font-weight: 400;
    font-size: 14px;
    letter-spacing: 0;
        line-height: normal;
    
  }
.section-{{ section.id }}-padding .variants-part{margin:10px 0;}
  /* COLOR SELECTOR */
  .section-{{ section.id }}-padding .color-group {
    display: flex;
    border: 1px solid #000;
    overflow: hidden;
    width: 100%;
  }

  .section-{{ section.id }}-padding .color-option {
    flex: 1;
    padding:3px 16px;
    min-height: 40px;
    cursor: pointer;
    position: relative;
    background: #fff;
    transition: color 0.3s; 
    position: relative;
    overflow: hidden;
    z-index: 1;
    font-size:18px;
    font-weight: 400;
letter-spacing: -0.36px;
   text-transform: capitalize;

  }
.section-{{ section.id }}-padding .color-option-bg {
    position: absolute;
    left: 0;
    height: 100%;
    top: 0;
    bottom: 0;
    width: 5px;
}

.section-{{ section.id }}-padding .color-option span {
  position: relative;
  z-index: 2;
}
.section-{{ section.id }}-padding .color-option.active {
    color: #fff;
  }

  /* sliding fill */

.section-{{ section.id }}-padding .color-option::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: black;
  z-index: -1;

  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.3s ease;
}

.section-{{ section.id }}-padding .color-option.active::before {
  transform: scaleX(1);
}



  /* DROPDOWN */
  .section-{{ section.id }}-padding .dropdown {
    width: 100%;
    position: relative;
  }

  .section-{{ section.id }}-padding .dropdown-header {
    border: 1px solid #000;
    padding-left: 20px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
        align-items: center;
  }
.section-{{ section.id }}-padding .selectedSize{font-size: 16px;letter-spacing: -0.32px;}
.section-{{ section.id }}-padding .dropdown-arrow {
    border-left: #000 solid 1px;
    width: 54px;
    text-align: center;
    padding: 6px;
    height: 40px;
}
.section-{{ section.id }}-padding .dropdown-arrow svg{  transition: transform 0.3s ease;}
.section-{{ section.id }}-padding .dropdown-header.active .dropdown-arrow svg {    transform: rotate(180deg);}
 .section-{{ section.id }}-padding .dropdown-list {
    border: 1px solid #000;
    border-top: none;
    display: none;
    position: absolute;
    width: 100%;
    background: #fff;
    z-index: 10;
    text-align:center;
   letter-spacing: -0.32px;
     font-size:16px;
     max-height: 110px;
    overflow: auto;
  }

  .section-{{ section.id }}-padding .dropdown-list.open {
    display: block;
  }

  .section-{{ section.id }}-padding .dropdown-item {
    padding: 5px 5px;
    cursor: pointer;
  }

  .section-{{ section.id }}-padding .dropdown-item:hover {
    background: #000; color:#fff;
  }

@media(max-width:767px) {
    .section-{{ section.id }}-padding .section-header{padding:0 0 20px;}
  .section-{{ section.id }}-padding .section-header h2{font-size: 25px; text-align:center;}
.section-{{ section.id }}-padding .hotspot-description {    font-size: 12px;    line-height: 1.3;}
.section-{{ section.id }}-padding .hotspot-wrapper {    gap: 5px;}
.section-{{ section.id }}-padding .hotspot-wrapper-item{  width: calc(50% - 5px / 2); }
.section-{{ section.id }}-padding .hotspot-point {    width: 16px;    height: 16px;    }
.section-{{ section.id }}-padding .hotspot-point svg{width:7px; height:7px;}
.section-{{ section.id }}-padding .hotspot-popup-max {max-width:311px;}

}

 {% for block in section.blocks %}
  .vsb_{{ block.id }} .hotspot-point{top: {{ block.settings.top }}%; left: {{ block.settings.left }}%;}

  @media(max-width:767px) {
      .vsb_{{ block.id }} .hotspot-point{top: {{ block.settings.top_m }}%; left: {{ block.settings.left_m }}%;}
  }
 {% endfor %} 
 </style>
<section class="section-{{ section.id }}-padding hotspot-section">
  <div class="page-width">
  {% if section.settings.heading != blank %}  <div class="section-header">  <h2>{{ section.settings.heading }}</h2>   </div> {% endif %}

    <div class="hotspot-wrapper">
      {% for block in section.blocks %}
        {% assign product = all_products[block.settings.product] %}
<div class="hotspot-wrapper-item vsb_{{ block.id }}">
     <div class="hotspot-featured-image"> <img src="{{ product.featured_image | image_url: width: 800 }}"></div>
        <div 
          class="hotspot-point"
         
          data-product='{{ product | json | replace: "'", "&apos;" }}'
        >
          {% render 'plus-icon' %}
        </div>
   <!-- ✅ POPUP CODE -->
    <div class="hotspot-popup" id="hotspotPopup">
       <div class="hotspot-popup-max">
        <div class="close-btn">{% render 'close-icon-popup' %}</div>
         <div class="hotspot-popup-inner">
             <div class="hotspot-popup-left"><img src="{{ product.featured_image | image_url: width: 400 }}"></div>
             <div class="hotspot-popup-right">
              <h2 class="pro_title">{{ product.title }}</h2>
              <div class="hotspot-price">{{ product.price | money_with_currency }}</div>
              {% if product.description != blank %}  <div class="hotspot-description"> {{ product.description }} </div> {% endif %}
             </div>
         </div>
            
         
          <div class="hotspot-popup-bottom">
              <div class="hotspot-popup-bottom-space">
             <!-- Color -->
            <div class="variants-part variants-part-color" data-option-index="0">
              <label class="variants-label">Color</label>
              <div class="color-group">
                {% assign color_option_index = -1 %}
                {% for option in product.options_with_values %}
                  {% if option.name == 'Color' %}
                    {% assign color_option_index = forloop.index0 %}
                    {% for value in option.values %}
                      {% if value.swatch != blank %}
                        {% assign color_code = value.swatch.color | default: value | handleize | prepend: '#' %}
                      {% else %}  
                        {% assign color_code = value | handleize %}
                      {% endif %}
                      <div class="color-option{% if forloop.first %} active{% endif %}" data-value="{{ value | escape }}" data-color="{{ color_code }}">
                        <div class="color-option-bg" style="background:{{ color_code }}">&nbsp;</div>
                        <span>{{ value }}</span>
                      </div>
                    {% endfor %}
                  {% endif %}
                {% endfor %}
                {% if color_option_index == -1 %}
                  <div class="color-option active" data-value="default">
                    <div class="color-option-bg" style="background:#000000">&nbsp;</div>
                    <span>Default</span>
                  </div>
                {% endif %}
              </div>
            </div>

          <!-- SIZE -->
          <div class="variants-part variants-part-size" data-option-index="1">
            <label class="variants-label">Size</label>
            <div class="dropdown">
              <div class="dropdown-header">
                {% assign size_option_index = -1 %}
                {% assign has_size = false %}
                {% for option in product.options_with_values %}
                  {% if option.name == 'Size' %}
                    {% assign has_size = true %}
                    {% assign size_option_index = forloop.index0 %}
                    <span class="selectedSize" data-value="{{ option.values.first | escape }}">{{ option.values.first }}</span>
                  {% endif %}
                {% endfor %}
                {% unless has_size %}
                  <span class="selectedSize" data-value="default">Default</span>
                {% endunless %}
                <span class="dropdown-arrow">{% render 'arrow-down-icon' %}</span>
              </div>
              {% if has_size %}
                <div class="dropdown-list">
                  {% for option in product.options_with_values %}
                    {% if option.name == 'Size' %}
                      {% for value in option.values %}
                        <div class="dropdown-item{% if forloop.first %} selected{% endif %}" data-value="{{ value | escape }}">{{ value }}</div>
                      {% endfor %}
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
          </div>
           {% if section.settings.btn_text != blank %}
             <button class="btn-custom add-to-cart-btn" data-product-id="{{ product.id }}" data-variant-id="{{ product.selected_or_first_available_variant.id }}">
               <span>{{ section.settings.btn_text }} {% render 'arrow-right' %}</span>
             </button>
           {% endif %}
          </div>

         </div>
    </div>
  </div>

      {% endfor %}
    </div>


  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
  // Product variants data for each hotspot
  const productVariants = {};

  document.querySelectorAll(".hotspot-wrapper-item").forEach(function(item) {
    const point = item.querySelector(".hotspot-point");
    const popup = item.querySelector(".hotspot-popup");
    const closeBtn = item.querySelector(".close-btn");
    const addToCartBtn = item.querySelector(".add-to-cart-btn");
    const productData = point.dataset.product;

    let variants = [];
    if (productData) {
      try {
        const product = JSON.parse(productData);
        variants = product.variants || [];
        if (addToCartBtn && product.variants && product.variants.length > 0) {
          productVariants[item.dataset.productId || product.id] = product.variants;
        }
      } catch (e) {
        console.error('Error parsing product data:', e);
      }
    }

    // Open popup
    point.addEventListener("click", function() {
      popup.classList.add("open_popup");
    });

    // Close popup
    closeBtn.addEventListener("click", function() {
      popup.classList.remove("open_popup");
    });

    // COLOR SELECT - scoped to this item
    const colorGroup = item.querySelector(".variants-part-color .color-group");
    if (colorGroup) {
      const colorOptions = colorGroup.querySelectorAll(".color-option");
      colorOptions.forEach(option => {
        option.addEventListener("click", () => {
          colorOptions.forEach(o => o.classList.remove("active"));
          option.classList.add("active");
          updateVariantId(item, addToCartBtn, variants);
        });
      });
    }

    // SIZE DROPDOWN - scoped to this item
    const sizeDropdown = item.querySelector(".variants-part-size .dropdown");
    if (sizeDropdown) {
      const header = sizeDropdown.querySelector(".dropdown-header");
      const list = sizeDropdown.querySelector(".dropdown-list");
      const items = sizeDropdown.querySelectorAll(".dropdown-item");
      const selected = sizeDropdown.querySelector(".selectedSize");

      if (header && list) {
        header.addEventListener("click", (e) => {
          e.stopPropagation();
          list.classList.toggle("open");
          header.classList.toggle("active");
        });

        items.forEach(dropdownItem => {
          dropdownItem.addEventListener("click", (e) => {
            e.stopPropagation();
            selected.textContent = dropdownItem.textContent;
            selected.dataset.value = dropdownItem.dataset.value;
            list.classList.remove("open");
            header.classList.remove("active");
            items.forEach(i => i.classList.remove("selected"));
            dropdownItem.classList.add("selected");
            updateVariantId(item, addToCartBtn, variants);
          });
        });

        // Close dropdown when clicking outside
        document.addEventListener("click", (e) => {
          if (!sizeDropdown.contains(e.target)) {
            list.classList.remove("open");
            header.classList.remove("active");
          }
        });
      }
    }

    // Add to cart functionality
    if (addToCartBtn) {
      addToCartBtn.addEventListener("click", function(e) {
        e.preventDefault();
        const variantId = this.dataset.variantId;
        if (variantId) {
          addToCart(variantId, this);
        }
      });
    }
  });

  // Function to update variant ID based on selected color and size
  function updateVariantId(item, addToCartBtn, variants) {
    if (!addToCartBtn || !variants || variants.length === 0) return;

    const colorPart = item.querySelector(".variants-part-color");
    const sizePart = item.querySelector(".variants-part-size");

    let selectedColor = null;
    let selectedSize = null;

    if (colorPart) {
      const activeColor = colorPart.querySelector(".color-option.active");
      if (activeColor) {
        selectedColor = activeColor.dataset.value;
      }
    }

    if (sizePart) {
      const selectedSizeEl = sizePart.querySelector(".selectedSize");
      if (selectedSizeEl) {
        selectedSize = selectedSizeEl.dataset.value;
      }
    }

    // Find matching variant
    let matchingVariant = null;

    for (const variant of variants) {
      let colorMatch = !selectedColor || variant.option1 === selectedColor || variant.option2 === selectedColor || variant.option3 === selectedColor;
      let sizeMatch = !selectedSize || variant.option1 === selectedSize || variant.option2 === selectedSize || variant.option3 === selectedSize;

      if (selectedColor && selectedSize) {
        // Both selected - need exact match
        if ((variant.option1 === selectedColor && variant.option2 === selectedSize) ||
            (variant.option1 === selectedSize && variant.option2 === selectedColor) ||
            (variant.option2 === selectedColor && variant.option3 === selectedSize) ||
            (variant.option2 === selectedSize && variant.option3 === selectedColor) ||
            (variant.option1 === selectedColor && variant.option3 === selectedSize) ||
            (variant.option1 === selectedSize && variant.option3 === selectedColor)) {
          matchingVariant = variant;
          break;
        }
      } else if (selectedColor) {
        // Only color selected
        if (variant.option1 === selectedColor || variant.option2 === selectedColor || variant.option3 === selectedColor) {
          matchingVariant = variant;
          break;
        }
      } else if (selectedSize) {
        // Only size selected
        if (variant.option1 === selectedSize || variant.option2 === selectedSize || variant.option3 === selectedSize) {
          matchingVariant = variant;
          break;
        }
      }
    }

    if (matchingVariant) {
      addToCartBtn.dataset.variantId = matchingVariant.id;
    }
  }

  // Add to cart function using Shopify Cart API
  function addToCart(variantId, button) {
    const originalText = button.innerHTML;
    button.innerHTML = '<span>Adding...</span>';
    button.disabled = true;

    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        id: variantId,
        quantity: 1
      })
    })
    .then(response => response.json())
    .then(data => {
      button.innerHTML = '<span>Added!</span>';
      setTimeout(() => {
        button.innerHTML = originalText;
        button.disabled = false;
      }, 1500);

      // Dispatch custom event for other cart handlers
      document.dispatchEvent(new CustomEvent('cart:updated', { detail: data }));
    })
    .catch(error => {
      console.error('Error adding to cart:', error);
      button.innerHTML = '<span>Error</span>';
      setTimeout(() => {
        button.innerHTML = originalText;
        button.disabled = false;
      }, 1500);
    });
  }
});
</script>

